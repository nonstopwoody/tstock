# Thai Stock AI Advisor — Environment variables
# Copy this file to `.env` and fill in real values
# (.env is git-ignored so secrets never reach the repo)

# Required for Phase 1+ once Claude API is wired up
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — used in Phase 3 (LINE Notify or alternative)
# LINE_TOKEN=your-line-notify-token

# Optional — used in Phase 4 (GitHub Actions deployment)
# GITHUB_TOKEN=ghp_your-token
